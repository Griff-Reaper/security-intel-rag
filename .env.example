# API Keys
ANTHROPIC_API_KEY=your_api_key_here

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db
COLLECTION_NAME=security_intel

# Embedding Model Settings
# all-MiniLM-L6-v2 is fast, free, and runs locally (384 dimensions)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Claude Settings
# Note: temperature/top_p/top_k are rejected with a 400 on current models.
CLAUDE_MODEL=claude-opus-5
MAX_TOKENS=4096

# NVD API key - optional, raises the rate limit for incremental updates.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
